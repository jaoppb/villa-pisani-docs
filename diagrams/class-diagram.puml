' ===================================
' ### GLOBAL RELATIONSHIPS ###
' ===================================

' --- Core Dependencies ---
AppController ..> AppService
PasswordEncryption ..> AppConfigService
FilesService ..> AppConfigService
CustomLogger ..> AppConfigService

' --- Auth Dependencies ---
AuthController ..> AuthService
AuthService ..> UserService
AuthService ..> PasswordEncryption
AuthService ..> AppConfigService
AuthService ..> ApartmentsService
AuthGuard ..> AuthService
AuthGuard ..> UserService
GlobalGuard ..> AuthGuard
GlobalGuard ..> RoleGuard
GlobalGuard ..> PublicGuard

' --- User Dependencies ---
UserController ..> UserService
UserService ..> PasswordEncryption
UserService ..> ApartmentsService
UserGenerateService ..> UserService
UserGenerateService ..> AppConfigService

' --- Entity Relationships (Composition) ---
User "1" *-- "feedbacks" Feedback
User "1" *-- "notices" Notice
Apartment "1" *-- "inhabitants" User
Apartment "1" *-- "bills" Bill
Apartment "1" *-- "deliveries" Delivery
Apartment "1" *-- "notices" Notice

' --- Apartment Dependencies ---
ApartmentsController ..> ApartmentsService
ApartmentsController ..> AuthService
ApartmentsService ..> UserService

' --- Bill Dependencies ---
BillsController ..> BillsService
BillsService ..> BillFilesService
BillsService ..> AppConfigService
BillFilesController ..> BillFilesService
BillFilesService ..> FilesService
Bill "1" *-- "1" BillFile

' --- Delivery Dependencies ---
DeliveriesController ..> DeliveriesService
DeliveriesService ..> ApartmentsService

' --- Notice Dependencies ---
NoticesController ..> NoticesService
NoticesService ..> UserService
NoticesService ..> ApartmentsService

' --- Feedback Dependencies ---
FeedbackController ..> FeedbackService

' --- Expense Dependencies ---
ExpensesController ..> ExpensesService
ExpensesService ..> ExpenseFilesService
ExpensesService ..> TagsService
ExpenseFilesController ..> ExpenseFilesService
ExpenseFilesService ..> FilesService
TagsController ..> TagsService
Expense "1" *-- "tags" Tag
Expense "1" *-- "files" ExpenseFile

' --- Meeting Dependencies ---
MeetingsController ..> MeetingsService
MeetingsService ..> MeetingFilesService
MeetingFilesController ..> MeetingFilesService
MeetingFilesService ..> FilesService
Meeting "1" *-- "1" MeetingFile

' --- Rule Dependencies ---
RulesController ..> RulesService

' --- Abstract File Inheritance ---
BillFile <|-- File
ExpenseFile <|-- File
MeetingFile <|-- File

' --- DTO Inheritance ---
ReadNoticeDto <|-- Notice

@enduml
